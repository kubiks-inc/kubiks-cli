{
  "name": "kubiks-instrumentation",
  "version": "1.0.0",
  "description": "OpenTelemetry instrumentation for Kubiks CLI",
  "main": "dist/instrumentation.js",
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild dist/instrumentation.js --bundle --platform=node --target=node18 --format=cjs --outfile=dist/instrumentation.bundled.js --external:path",
    "clean": "rm -rf dist",
    "prepare": "npm install"
  },
  "dependencies": {
    "@kubiks/otel-nextjs": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0"
  }
}